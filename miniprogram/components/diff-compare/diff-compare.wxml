<!-- components/diff-compare/diff-compare.wxml -->
<!-- 冰与火之歌 书籍 vs 剧集对比组件 -->

<view class="diff-compare {{isEmpty ? 'empty' : ''}}">
  <!-- Header -->
  <view class="diff-header" wx:if="{{showTitle}}">
    <text class="diff-title">{{title}}</text>
    <view class="diff-mode-toggle" wx:if="{{differences.length > 0}}" bindtap="onToggleMode">
      <text class="toggle-text">{{displayMode === 'stacked' ? '并列' : '堆叠'}}</text>
    </view>
  </view>

  <!-- Empty State -->
  <view class="diff-empty" wx:if="{{isEmpty}}">
    <text class="empty-text">暂无对比数据</text>
  </view>

  <!-- Stacked Mode -->
  <view class="diff-list stacked" wx:if="{{!isEmpty && displayMode === 'stacked'}}">
    <block wx:for="{{differences}}" wx:key="aspect">
      <view class="diff-item">
        <view class="diff-aspect">
          <text class="aspect-label">对比项目</text>
          <text class="aspect-name">{{item.aspect}}</text>
        </view>

        <view class="diff-columns">
          <!-- Book Side -->
          <view class="diff-side book">
            <view class="side-header book-header">
              <text class="side-icon">&#x1F4D4;</text>
              <text class="side-label">原著</text>
            </view>
            <text class="side-content">{{item.book}}</text>
          </view>

          <!-- Show Side -->
          <view class="diff-side show">
            <view class="side-header show-header">
              <text class="side-icon">&#x1F3AC;</text>
              <text class="side-label">剧集</text>
            </view>
            <text class="side-content">{{item.show}}</text>
          </view>
        </view>
      </view>
    </block>
  </view>

  <!-- Side-by-Side Mode -->
  <view class="diff-list side-by-side" wx:if="{{!isEmpty && displayMode === 'side-by-side'}}">
    <block wx:for="{{differences}}" wx:key="aspect">
      <view class="diff-item-horizontal">
        <view class="diff-aspect-horizontal">
          <text class="aspect-name">{{item.aspect}}</text>
        </view>

        <view class="diff-columns-horizontal">
          <view class="diff-side-h book">
            <view class="side-header book-header">
              <text class="side-icon">&#x1F4D4;</text>
              <text class="side-label">原著</text>
            </view>
            <text class="side-content">{{item.book}}</text>
          </view>

          <view class="diff-divider">
            <text class="divider-text">VS</text>
          </view>

          <view class="diff-side-h show">
            <view class="side-header show-header">
              <text class="side-icon">&#x1F3AC;</text>
              <text class="side-label">剧集</text>
            </view>
            <text class="side-content">{{item.show}}</text>
          </view>
        </view>
      </view>
    </block>
  </view>
</view>
