.char-card {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
}

.char-card-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--gold-dark), var(--gold));
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.char-card-avatar text {
  font-size: 30rpx;
  font-weight: 700;
  color: #261f18;
}

.char-card-info {
  flex: 1;
  overflow: hidden;
}

.char-card-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.char-card-titles {
  font-size: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.char-card-status {
  flex-shrink: 0;
  margin-left: 12rpx;
}

.char-card-arrow {
  font-size: 36rpx;
  color: var(--text-muted);
  margin-left: 8rpx;
  font-weight: 300;
}
