.setup-panel { background:#2a1f14; border:1rpx solid #3a2f24; border-radius:16rpx; padding:40rpx 32rpx; margin-bottom:20rpx; text-align:center; }
.setup-title { font-size:34rpx; color:#d4a853; font-weight:bold; margin-bottom:10rpx; }
.setup-desc { font-size:22rpx; color:#8a7b68; margin-bottom:32rpx; }

.avatar-btn { width:100%; background:transparent; border:none; padding:0; margin:0; display:flex; flex-direction:column; align-items:center; line-height:1; }
.avatar-btn::after { border:none; }
.setup-avatar { width:140rpx; height:140rpx; border-radius:50%; }
.setup-avatar-placeholder { background:#1e1812; border:2rpx dashed #d4a853; display:flex; align-items:center; justify-content:center; font-size:64rpx; }
.avatar-hint { font-size:22rpx; color:#c0a060; margin-top:16rpx; margin-bottom:32rpx; }

.nick-input { width:100%; box-sizing:border-box; background:#1e1812; border:1rpx solid #3a2f24; border-radius:12rpx; padding:20rpx; font-size:28rpx; color:var(--text-primary); margin-bottom:32rpx; text-align:center; }
.nick-placeholder { color:#6a5e4e; }

.setup-confirm { background:#d4a853; color:#1e1812; font-weight:bold; font-size:28rpx; border-radius:44rpx; border:none; padding:16rpx 0; letter-spacing:6rpx; }
.setup-confirm::after { border:none; }
.setup-confirm[disabled] { opacity:0.6; color:#1e1812; }

.setup-skip { font-size:22rpx; color:#8a7b68; margin-top:20rpx; padding:8rpx 0; }
