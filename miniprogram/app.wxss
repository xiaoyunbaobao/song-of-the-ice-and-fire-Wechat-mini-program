/* ==============================
   冰与火之歌 · 全局样式
   主题：深褐羊皮卷轴 + 浅黄鎏金
   ============================== */

/* === 颜色变量（通过 CSS 自定义属性） === */
page {
  --bg-primary: #1e1812;
  --bg-secondary: #261f18;
  --bg-card: #2d241a;
  --bg-card-hover: #362c20;
  --gold: #d4a853;
  --gold-light: #e2c978;
  --gold-dark: #b8943e;
  --text-primary: #ede4d3;
  --text-secondary: #b8a68e;
  --text-muted: #8a7b68;
  --ice-blue: #8fb8c4;
  --fire-red: #c4553a;
  --fire-orange: #d4845a;
  --border-color: #3d3024;
  --success: #5a9c5d;
  --danger: #a04a3a;

  background-color: var(--bg-primary);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* === 通用布局 === */
.container {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-wrap {
  display: flex;
  flex-wrap: wrap;
}

/* === 卡片 === */
.card {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border-color);
  transition: all 0.2s;
}

.card:active {
  background: var(--bg-card-hover);
  transform: scale(0.98);
}

/* === 文字 === */
.text-gold {
  color: var(--gold);
}

.text-muted {
  color: var(--text-muted);
}

.text-secondary {
  color: var(--text-secondary);
}

.text-ice {
  color: var(--ice-blue);
}

.text-fire {
  color: var(--fire-red);
}

.text-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.text-subtitle {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--gold-light);
}

.text-body {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.8;
}

.text-sm {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* === 标签 === */
.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.tag-gold {
  background: rgba(212, 168, 83, 0.15);
  color: var(--gold);
  border: 1rpx solid rgba(212, 168, 83, 0.3);
}

.tag-ice {
  background: rgba(143, 184, 196, 0.15);
  color: var(--ice-blue);
  border: 1rpx solid rgba(143, 184, 196, 0.3);
}

.tag-fire {
  background: rgba(196, 85, 58, 0.15);
  color: var(--fire-red);
  border: 1rpx solid rgba(196, 85, 58, 0.3);
}

.tag-status-alive {
  background: rgba(90, 156, 93, 0.15);
  color: var(--success);
}

.tag-status-dead {
  background: rgba(160, 74, 58, 0.15);
  color: var(--danger);
}

/* === 分割线 === */
.divider {
  height: 1rpx;
  background: var(--border-color);
  margin: 24rpx 0;
}

.divider-gold {
  height: 2rpx;
  background: linear-gradient(90deg, transparent, var(--gold), transparent);
  margin: 32rpx 0;
}

/* === 按钮 === */
.btn {
  padding: 16rpx 32rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  text-align: center;
}

.btn-gold {
  background: var(--gold);
  color: #261f18;
  font-weight: 600;
}

.btn-outline {
  background: transparent;
  border: 2rpx solid var(--gold);
  color: var(--gold);
}

/* === 空状态 === */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}

.empty-state .icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-state .text {
  color: var(--text-muted);
  font-size: 28rpx;
}

/* === 加载骨架屏 === */
.skeleton {
  background: linear-gradient(90deg, var(--bg-card) 25%, var(--bg-card-hover) 50%, var(--bg-card) 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s ease-in-out infinite;
  border-radius: 8rpx;
}

@keyframes skeleton-loading {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* === 滚动条美化 === */
::-webkit-scrollbar {
  width: 4rpx;
}

::-webkit-scrollbar-thumb {
  background: var(--border-color);
  border-radius: 4rpx;
}
