.page { background:var(--bg-primary); min-height:100vh; padding:24rpx; }

.hero { padding:32rpx; margin-bottom:24rpx; text-align:center; }
.article-category { font-size:22rpx; margin-bottom:8rpx; }
.article-title { font-size:40rpx; font-weight:700; color:var(--gold); letter-spacing:4rpx; }

.images-section { margin-bottom:24rpx; }
.image-card { padding:8rpx; margin-bottom:16rpx; }
.article-img { width:100%; display:block; border-radius:12rpx; }

.content { padding:28rpx; margin-bottom:24rpx; }
.article-text { line-height:2; }

.img-block { margin:24rpx 0; }
.article-img { width:100%; display:block; border-radius:12rpx; }
.img-caption-placeholder { text-align:center; padding:16rpx 0 8rpx; font-size:24rpx; font-style:italic; }
.img-caption { text-align:center; padding:16rpx 0 8rpx; line-height:1.8; }

.wiki-link { color:#d4a853; text-decoration:underline; text-underline-offset:4rpx; }
.wiki-link:active { color:#e2c978; background:rgba(212,168,83,0.15); border-radius:4rpx; }

.img-placeholder { display:flex; flex-direction:column; align-items:center; padding:60rpx 32rpx; }
.img-ph-icon { font-size:64rpx; margin-bottom:12rpx; opacity:0.5; }
