.page { background:#1e1812; min-height:100vh; padding-bottom:120rpx; }
.cat-scroll { white-space:nowrap; background:#2a1f14; padding:12rpx 16rpx; }
.cat-tabs { display:inline-flex; gap:8rpx; }
.cat-tab { display:inline-block; padding:10rpx 20rpx; font-size:24rpx; color:#8a7b68; background:#1e1812; border-radius:20rpx; }
.cat-tab.active { background:#3a2f24; color:#d4a853; border:1rpx solid #d4a853; }

.theory-list { padding:16rpx 24rpx; }
.theory-card { background:#2a1f14; border-radius:12rpx; padding:24rpx; margin-bottom:20rpx; border-left:4rpx solid #d4a853; }
.theory-header { display:flex; align-items:center; gap:12rpx; }
.theory-icon { font-size:40rpx; }
.theory-img { width:48rpx; height:48rpx; border-radius:6rpx; flex-shrink:0; }
.theory-title-row { flex:1; }
.theory-title { font-size:28rpx; color:#d4a853; font-weight:bold; display:block; margin-bottom:4rpx; }
.theory-meta { display:flex; gap:8rpx; }
.theory-status { font-size:22rpx; padding:2rpx 10rpx; border-radius:8rpx; }
.expand-icon { font-size:28rpx; color:#8a7b68; }
.theory-summary { font-size:26rpx; color:#a09888; margin-top:12rpx; line-height:1.6; }

.theory-evidence { margin-top:20rpx; padding-top:16rpx; border-top:1rpx solid #3a2f24; }
.ev-section-title { font-size:24rpx; color:#d4a853; margin-bottom:12rpx; }
.ev-item { margin-bottom:12rpx; padding:12rpx; background:#1e1812; border-radius:8rpx; }
.ev-tag { font-size:20rpx; padding:2rpx 8rpx; border-radius:6rpx; margin-right:8rpx; }
.tag-book { background:#1e3a2f; color:#5a9a6f; }
.tag-interview { background:#3a2f1e; color:#c0a060; }
.tag-show { background:#2a1f3a; color:#8a6aba; }
.ev-text { font-size:25rpx; color:#948c7c; line-height:1.7; }

.ev-links { margin-top:16rpx; }
.link-row { display:flex; flex-wrap:wrap; gap:10rpx; margin-top:8rpx; }
.link-tag { padding:6rpx 14rpx; border-radius:14rpx; font-size:22rpx; }
.tag-char { background:#3a2f1e; color:#c0a060; }
.tag-wiki { background:#1e3a2f; color:#5a9a6f; }

.empty { text-align:center; padding:80rpx 0; color:#8a7b68; font-size:28rpx; }
