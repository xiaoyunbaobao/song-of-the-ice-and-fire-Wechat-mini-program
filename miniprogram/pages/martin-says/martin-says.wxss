/* === 马丁如是说 === */
.page {
  background: var(--bg-primary);
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 头图（瀑布流） */
.header-banner {
  position: relative; text-align: center; padding: 48rpx 32rpx;
  background: #1a1410; overflow: hidden;
  height: 320rpx; display: flex; align-items: center; justify-content: center;
  border-bottom: 1rpx solid var(--border-color);
}
.banner-waterfall { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 0; display: flex; flex-direction: column; gap: 8rpx; padding: 8rpx 0; }
.banner-row { display: flex; flex-wrap: nowrap; height: 46%; }
.banner-cover { height: 100%; width: 140rpx; flex-shrink: 0; margin-right: 8rpx; border-radius: 6rpx; opacity: 0.55; }
.banner-row-1 { animation: msScroll1 60s linear infinite; }
.banner-row-2 { animation: msScroll2 75s linear infinite; }
@keyframes msScroll1 { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
@keyframes msScroll2 { 0% { transform: translateX(-50%); } 100% { transform: translateX(0); } }

.hero-mask { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(18,12,6,0.5); z-index: 1; }
.banner-content { position: relative; z-index: 2; }
.banner-icon { font-size: 52rpx; margin-bottom: 8rpx; text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.6); }
.banner-title { font-size: 36rpx; font-weight: 700; color: var(--gold); letter-spacing: 8rpx; margin-bottom: 6rpx; text-shadow: 0 2rpx 10rpx rgba(0,0,0,0.7); }
.banner-subtitle { font-size: 24rpx; color: var(--text-secondary); margin-bottom: 8rpx; }
.banner-note { font-size: 20rpx; color: var(--text-secondary); font-style: italic; }

/* 分类滚动 */
.category-scroll {
  white-space: nowrap;
  padding: 24rpx;
}

.category-list {
  display: inline-flex;
  gap: 16rpx;
}

.category-chip {
  display: inline-block;
  padding: 12rpx 28rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border-color);
  border-radius: 32rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  white-space: nowrap;
}

.category-chip.active {
  background: rgba(212,168,83,0.18);
  color: var(--gold);
  border-color: var(--gold);
}

/* 条目 */
.entry-list {
  padding: 0 24rpx;
}

.entry-card {
  margin-bottom: 24rpx;
}

.entry-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.entry-date {
  font-size: 22rpx;
}

.entry-title {
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.entry-quote {
  position: relative;
  padding: 8rpx 0 8rpx 24rpx;
  border-left: 4rpx solid var(--gold);
}

.quote-mark {
  position: absolute;
  left: -12rpx;
  top: -8rpx;
  font-size: 48rpx;
  color: var(--gold);
  font-family: Georgia, serif;
  line-height: 1;
  opacity: 0.6;
}

.entry-tags {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

/* 底部 */
.footer-note {
  text-align: center;
  padding: 32rpx 48rpx;
}

.footer-note text {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
}
