<!-- 马丁如是说 —— So Spake Martin -->
<view class="page">
  <!-- 头图 -->
  <view class="header-banner">
    <view class="banner-waterfall">
      <view class="banner-row banner-row-1">
        <image wx:for="{{bannerRow1}}" wx:key="*this" class="banner-cover" src="{{item}}" mode="aspectFill" />
        <image wx:for="{{bannerRow1}}" wx:key="*this" class="banner-cover" src="{{item}}" mode="aspectFill" />
      </view>
      <view class="banner-row banner-row-2">
        <image wx:for="{{bannerRow2}}" wx:key="*this" class="banner-cover" src="{{item}}" mode="aspectFill" />
        <image wx:for="{{bannerRow2}}" wx:key="*this" class="banner-cover" src="{{item}}" mode="aspectFill" />
      </view>
    </view>
    <view class="hero-mask"></view>
    <view class="banner-content">
      <view class="banner-icon">✒️</view>
      <view class="banner-title">马丁如是说</view>
      <view class="banner-subtitle">乔治·R·R·马丁历年访谈、博客、座谈会发言汇编</view>
      <view class="banner-note">So Spake Martin · 参考冰与火之歌中文维基</view>
    </view>
  </view>

  <!-- 分类筛选 -->
  <scroll-view class="category-scroll" scroll-x="true">
    <view class="category-list">
      <view
        wx:for="{{categories}}"
        wx:key="key"
        class="category-chip {{activeCategory === item.key ? 'active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onCategoryChange"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <!-- 条目列表 -->
  <view class="entry-list">
    <view wx:for="{{filteredEntries}}" wx:key="id" class="entry-card card">
      <!-- 头部：日期 + 来源 -->
      <view class="entry-header">
        <view class="entry-date text-muted">{{item.date}}</view>
        <view class="entry-source tag tag-gold">{{item.source}}</view>
      </view>

      <!-- 标题 -->
      <view class="entry-title text-subtitle">{{item.title}}</view>

      <!-- 引言 -->
      <view class="entry-quote">
        <text class="quote-mark">"</text>
        <text class="text-body">{{item.quote}}</text>
      </view>

      <!-- 标签 -->
      <view class="entry-tags" wx:if="{{item.tags && item.tags.length}}">
        <text wx:for="{{item.tags}}" wx:key="*this" class="tag tag-ice">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{filteredEntries.length === 0}}">
    <text class="icon">📜</text>
    <text class="text">暂无该分类的内容</text>
  </view>

  <!-- 底部 -->
  <view class="footer-note">
    <view class="divider-gold"></view>
    <text class="text-muted">内容持续更新 · 所有引文来自乔治·R·R·马丁公开发言</text>
  </view>
</view>
