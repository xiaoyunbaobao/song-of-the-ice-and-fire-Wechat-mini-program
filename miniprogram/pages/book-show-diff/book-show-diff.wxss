/* === 书剧差异页 === */
.page {
  padding: 24rpx;
  background: var(--bg-primary);
  min-height: 100vh;
}

/* ===== 页面标题 ===== */
.page-header {
  text-align: center;
  margin-bottom: 24rpx;
  padding: 16rpx 0;
}

.page-title {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.page-subtitle {
  font-size: 26rpx;
}

/* ===== Tab 栏 ===== */
.tab-bar {
  display: flex;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border-color);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--text-muted);
  transition: all 0.2s;
}

.tab-item.active {
  background: rgba(212, 168, 83, 0.15);
  color: var(--gold);
  font-weight: 600;
}

/* ===== 加载骨架 ===== */
.loading-skeleton {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.loading-skeleton .skeleton-line {
  height: 28rpx;
  margin-bottom: 16rpx;
  border-radius: 8rpx;
}

/* ===== 差异卡片（通用） ===== */
.diff-list {
  display: flex;
  flex-direction: column;
}

.diff-card {
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border-color);
}

.diff-card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: 12rpx;
}

.diff-card-title {
  flex: 1;
  font-size: 28rpx;
  min-width: 0;
}

.diff-card-category {
  flex-shrink: 0;
}

.char-link {
  flex-shrink: 0;
  font-size: 26rpx;
  padding: 4rpx 0;
}

.char-link text:active {
  color: var(--ice-blue);
  opacity: 0.7;
}

/* ===== 差异对比区域 ===== */
.diff-compare {
  display: flex;
  margin-top: 8rpx;
}

.diff-side {
  flex: 1;
}

.diff-side.diff-book {
  padding-right: 16rpx;
}

.diff-side.diff-show {
  padding-left: 16rpx;
}

.diff-side-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--gold);
  margin-bottom: 12rpx;
}

.diff-side-text {
  font-size: 26rpx;
  line-height: 1.8;
}

.diff-vs {
  width: 2rpx;
  background: var(--border-color);
  flex-shrink: 0;
}

/* ===== 差异详情文本 ===== */
.diff-detail {
  text-indent: 2em;
  line-height: 1.9;
}

.diff-source {
  margin-top: 16rpx;
  font-size: 22rpx;
  font-style: italic;
}

/* ===== 分割线 ===== */
.divider-gold {
  height: 2rpx;
  background: linear-gradient(90deg, transparent, var(--gold), transparent);
  margin: 18rpx 0;
}

/* ===== 删减角色卡片 ===== */
.cut-card {
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border-color);
}

.cut-card-header {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.cut-name {
  font-size: 30rpx;
}

.cut-identity {
  font-size: 24rpx;
}

.cut-significance {
  line-height: 1.9;
}

.cut-label {
  color: var(--gold);
  font-weight: 600;
}

/* ===== 底部留白 ===== */
.bottom-spacer {
  height: 80rpx;
}
