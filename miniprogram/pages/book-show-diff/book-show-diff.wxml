<!-- 书剧差异页 -->
<view class="page">
  <!-- 页面标题 -->
  <view class="page-header">
    <view class="page-title text-title">书剧差异</view>
    <view class="page-subtitle text-secondary">
      《冰与火之歌》原著与《权力的游戏》剧集对比
    </view>
  </view>

  <!-- 分类 Tab -->
  <view class="tab-bar">
    <view
      wx:for="{{categories}}"
      wx:key="key"
      class="tab-item {{activeTab === item.key ? 'active' : ''}}"
      data-tab="{{item.key}}"
      bindtap="onTabChange"
    >
      <text>{{item.label}}</text>
    </view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-skeleton">
    <view wx:for="{{[1,2,3]}}" wx:key="*this" class="skeleton card">
      <view class="skeleton skeleton-line" style="width:70%"></view>
      <view class="skeleton skeleton-line"></view>
      <view class="skeleton skeleton-line"></view>
      <view class="skeleton skeleton-line" style="width:50%"></view>
    </view>
  </view>

  <!-- ═══════════ 角色差异 ═══════════ -->
  <view wx:if="{{!loading && activeTab === 'characters'}}" class="diff-list">
    <view
      wx:for="{{characterDiffs}}"
      wx:key="_id"
      class="diff-card card"
    >
      <view class="diff-card-header">
        <view class="diff-card-title text-subtitle">{{item.title}}</view>
        <view
          class="char-link"
          wx:if="{{item.characterId}}"
          data-id="{{item.characterId}}"
          bindtap="onCharacterTap"
        >
          <text class="text-ice">查看角色 ›</text>
        </view>
      </view>
      <view class="divider-gold"></view>
      <view class="diff-compare">
        <view class="diff-side diff-book">
          <view class="diff-side-label">📖 原著</view>
          <text class="diff-side-text text-body">{{item.book}}</text>
        </view>
        <view class="diff-vs"></view>
        <view class="diff-side diff-show">
          <view class="diff-side-label">📺 剧集</view>
          <text class="diff-side-text text-body">{{item.show}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{characterDiffs.length === 0}}" class="empty-state">
      <text class="icon">📝</text>
      <text class="text">暂无角色差异记录</text>
    </view>
  </view>

  <!-- ═══════════ 剧情差异 ═══════════ -->
  <view wx:if="{{!loading && activeTab === 'plots'}}" class="diff-list">
    <view
      wx:for="{{plotDiffs}}"
      wx:key="_id"
      class="diff-card card"
    >
      <view class="diff-card-header">
        <view class="diff-card-title text-subtitle">{{item.title}}</view>
        <view class="diff-card-category">
          <text class="tag" style="background:rgba(212,168,83,0.15);color:var(--gold);border:1rpx solid rgba(212,168,83,0.3);">{{item.category}}</text>
        </view>
      </view>
      <view class="divider-gold"></view>
      <view class="diff-detail text-body">{{item.detail}}</view>
      <view class="diff-source text-muted" wx:if="{{item.source}}">
        来源：{{item.source}}
      </view>
    </view>

    <view wx:if="{{plotDiffs.length === 0}}" class="empty-state">
      <text class="icon">📝</text>
      <text class="text">暂无剧情差异记录</text>
    </view>
  </view>

  <!-- ═══════════ 删减角色 ═══════════ -->
  <view wx:if="{{!loading && activeTab === 'cut'}}" class="diff-list">
    <view
      wx:for="{{cutCharacters}}"
      wx:key="_id"
      class="cut-card card"
    >
      <view class="cut-card-header">
        <view class="cut-name text-subtitle">{{item.name}}</view>
        <view class="cut-identity text-gold">{{item.identity}}</view>
      </view>
      <view class="divider-gold"></view>
      <view class="cut-significance text-body">
        <text class="cut-label">在原著中的重要性：</text>
        {{item.significance}}
      </view>
    </view>

    <view wx:if="{{cutCharacters.length === 0}}" class="empty-state">
      <text class="icon">📝</text>
      <text class="text">暂无删减角色记录</text>
    </view>
  </view>

  <view class="bottom-spacer"></view>
</view>
