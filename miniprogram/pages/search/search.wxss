/* pages/search/search.wxss */
/* 冰与火之歌 搜索页样式 - Dark Theme */

/* ========== Page Container ========== */
.search-page {
  background-color: #1e1812;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ========== Search Bar ========== */
.search-bar-wrapper {
  padding: 20rpx 30rpx;
  background-color: #1e1812;
  position: sticky;
  top: 0;
  z-index: 100;
}

.search-input-container {
  display: flex;
  align-items: center;
  background-color: #2d241a;
  border: 1px solid #3d3024;
  border-radius: 40rpx;
  padding: 12rpx 24rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  height: 60rpx;
  font-size: 28rpx;
  color: #e0d5c1;
}

.search-placeholder {
  color: #6a6560;
}

.clear-icon {
  font-size: 24rpx;
  color: #6a6560;
  padding: 8rpx;
  margin-left: 8rpx;
}

/* ========== Search Status ========== */
.search-status {
  padding: 80rpx 40rpx;
  text-align: center;
}

.status-text {
  font-size: 26rpx;
  color: #6a6560;
}

/* ========== Empty State ========== */
.search-empty {
  padding: 120rpx 40rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-title {
  font-size: 32rpx;
  color: #e0d5c1;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #6a6560;
}

/* ========== Initial State ========== */
.search-initial {
  padding: 120rpx 40rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.initial-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.initial-title {
  font-size: 32rpx;
  color: #d4a853;
  margin-bottom: 12rpx;
}

.initial-desc {
  font-size: 24rpx;
  color: #6a6560;
}

/* ========== Results ========== */
.search-results {
  padding: 0 30rpx;
}

.results-header {
  padding: 16rpx 10rpx 20rpx;
}

.results-count {
  font-size: 22rpx;
  color: #6a6560;
}

/* ========== Section Header ========== */
.result-section {
  margin-bottom: 30rpx;
}

.section-header {
  display: flex;
  align-items: center;
  padding: 16rpx 10rpx;
  margin-bottom: 8rpx;
  border-bottom: 1px solid #3d3024;
}

.section-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #d4a853;
  flex: 1;
}

.section-count {
  font-size: 22rpx;
  color: #6a6560;
  background-color: rgba(106, 101, 96, 0.15);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

/* ========== Result Item ========== */
.result-item {
  display: flex;
  flex-direction: column;
  padding: 22rpx 20rpx;
  margin-bottom: 8rpx;
  background-color: #2d241a;
  border: 1px solid #3d3024;
  border-radius: 10rpx;
  position: relative;
  transition: background-color 0.2s ease;
}

.result-item:active {
  background-color: #1a2a4a;
}

.result-name {
  font-size: 28rpx;
  color: #e0d5c1;
  font-weight: bold;
  margin-bottom: 6rpx;
}

.result-sub {
  font-size: 22rpx;
  color: #a09888;
}

.result-arrow {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 36rpx;
  color: #6a6560;
}
