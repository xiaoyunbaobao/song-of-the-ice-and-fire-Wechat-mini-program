.page { padding: 0; background: #1e1812; min-height: 100vh; }
.region-tabs-scroll { white-space: nowrap; background: #2a1f14; padding: 12rpx 16rpx; }
.region-tabs { display: inline-flex; gap: 8rpx; }
.region-tab { display:inline-block; padding:10rpx 20rpx; font-size:24rpx; color:#8a7b68; background:#1e1812; border-radius:20rpx; margin-right:8rpx; }
.region-tab.active { background: #3a2f24; color: #d4a853; border: 1rpx solid #d4a853; }

.region-detail { padding: 16rpx 24rpx 120rpx; }
.region-header { display:flex; align-items:center; gap:16rpx; padding:24rpx 0; }
.region-icon { font-size:56rpx; }
.region-img { width:64rpx; height:64rpx; border-radius:8rpx; }
.region-title-row { display:flex; flex-direction:column; }
.region-name { font-size:36rpx; font-weight:bold; color:#d4a853; }
.region-map { font-size:24rpx; }

.card { background:#2a1f14; border-radius:12rpx; padding:24rpx; margin-bottom:20rpx; }
.overview-text { font-size:28rpx; color:#c0b8a8; line-height:1.8; }

.section-title { font-size:28rpx; color:#d4a853; font-weight:bold; margin-bottom:12rpx; }
.section-label { font-size:24rpx; color:#8a7b68; display:block; margin-bottom:8rpx; }
.section-text { font-size:26rpx; color:#a09888; line-height:1.7; }

.custom-item { padding:16rpx 0; border-bottom:1rpx solid #3a2f24; }
.custom-item:last-child { border-bottom:none; }
.custom-title { font-size:26rpx; color:#d4a853; margin-bottom:6rpx; }
.custom-desc { font-size:25rpx; color:#948c7c; line-height:1.6; }

.link-row { display:flex; flex-wrap:wrap; gap:12rpx; margin-top:12rpx; }
.link-tag { padding:8rpx 16rpx; border-radius:16rpx; font-size:22rpx; }
.tag-wiki { background:#1e3a2f; color:#5a9a6f; }
.tag-char { background:#3a2f1e; color:#c0a060; }
